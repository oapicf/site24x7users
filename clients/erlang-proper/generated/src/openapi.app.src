{ application, openapi
, [ {description, "Example OpenAPI specification for Swaggy C using Google Search"}
  , {vsn, "0.1.0"}
  , {registered, []}
  , { applications
    , [ kernel
      , stdlib
      , ssl
      , jsx
      ]
    }
  , { env
    , [ {host, "http://google.com"}
      , {basic_auth, {"admin", "admin"}}
      ]
    }
  , {modules, []}
  , {maintainers, []}
  , {licenses, ["MIT"]}
  , {links, ["https://github.com/oapicf/site24x7users"]}
]}.
